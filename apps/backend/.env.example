# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Security Secrets (Never commit actual production secrets)
JWT_SECRET=rollify_super_secure_jwt_token_secret_pos_2026_xyz987
JWT_EXPIRES_IN=24h

# Database Configuration
# Standard PostgreSQL URL format:
# postgresql://postgres:postgres@localhost:5432/rollify_pos
# If left blank or set to pglite://, the server will automatically use local persistent PGlite PostgreSQL engine
DATABASE_URL=
DATABASE_DATA_DIR=./data/postgres

# Application Settings
TAX_RATE_DEFAULT=5.00
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
